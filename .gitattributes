# Normalize to LF in the repo; check out natively.
* text=auto eol=lf

# Windows-only scripts must stay CRLF to run.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Gradle wrapper.
gradlew      text eol=lf
gradlew.bat  text eol=crlf
*.jar        binary

*.png binary
*.jpg binary
*.ico binary
*.apk binary
*.aab binary
