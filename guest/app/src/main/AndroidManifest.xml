<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required even for a loopback socket: Android gates socket creation on
         this permission. It is a normal permission, so no runtime dialog. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Digitiz">

        <!-- screenOrientation: the PC desktop is landscape, so a landscape
             surface fits far more of it on screen. sensorLandscape rather than
             landscape so the phone can be picked up either way round.
             configChanges keeps the activity alive across the rotation, which
             matters because the native side owns the GL surface. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|uiMode|density|smallestScreenSize"
            android:theme="@style/Theme.Digitiz">

            <!-- Tells GameActivity which native library to load. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="digitiz_guest" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
