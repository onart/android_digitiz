# Copy to guest/keystore.properties and fill in all four. That file is
# gitignored: the signing key and its passwords must not be in the repository.
# A signing key that leaks cannot be un-leaked -- whoever holds it can publish
# an update that Android will accept as yours.
#
# storeFile is deliberately blank. Leave it blank and the release APK simply
# comes out unsigned, which is what "not set up yet" should look like. Point it
# somewhere with no key at it and the build fails instead.
#
# Relative paths resolve from the guest/ directory, so ../ is the repository
# root -- which is not where the key should live. Put it outside the repository
# altogether and back it up: losing it means never updating the app under the
# same identity again.
#
# Create the key in Android Studio (Build > Generate Signed App Bundle / APK >
# APK > Create new...), or:
#
#   keytool -genkeypair -v -keystore C:/keys/digitiz-release.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias digitiz

storeFile=
storePassword=
keyAlias=digitiz
keyPassword=
