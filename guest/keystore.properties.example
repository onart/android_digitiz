# Copy to guest/keystore.properties and fill in. That file is gitignored:
# the signing key and its passwords must not be in the repository, and a key
# that leaks cannot be un-leaked -- anyone holding it can publish an update
# that Android will accept as yours.
#
# Create the key in Android Studio: Build > Generate Signed App Bundle / APK
# > APK > Create new..., or from the command line:
#
#   keytool -genkeypair -v -keystore digitiz-release.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias digitiz
#
# Keep the .jks file itself outside the repository as well, and back it up.
# Losing it means never being able to update the app under the same identity.

storeFile=../digitiz-release.jks
storePassword=
keyAlias=digitiz
keyPassword=
